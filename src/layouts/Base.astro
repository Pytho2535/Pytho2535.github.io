---
import '../styles/global.css';
import Bar from '../components/Bar.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Pytho — security researcher',
  description =
    'Pytho — security researcher and bug bounty hunter. Hack The Box writeups, profiles and contact.',
  image = '/images/banner.png',
} = Astro.props;

// Absolute URLs for social-share (Open Graph / Twitter) link previews.
const site = Astro.site ?? new URL('https://Pytho2535.github.io');
const ogImage = new URL(url(image), site).href;
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, iMessage, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pytho" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Pytho — security researcher" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%230B0B0F'/><text x='50' y='72' font-size='68' font-family='monospace' font-weight='700' fill='%232BE39B' text-anchor='middle'>P</text></svg>" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The mono the terminal is set in, and the sans a long writeup
         is set in. Nothing else is loaded. -->
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <Bar />

    <div class="wrap">
      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="foot">
        <span>pytho13@proton.me</span>
        <a href="https://github.com/Pytho2535" rel="noopener">github.com/Pytho2535</a>
      </footer>
    </div>
  </body>
</html>
