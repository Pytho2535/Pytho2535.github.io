---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Bar from '../components/Bar.astro';
import { url } from '../lib/url';
/* Imported rather than served from public/, so its URL carries a hash of
   the file. Discord, Slack and the rest cache a link preview by image
   URL; a new banner under the old name would never be fetched again. */
import banner from '../assets/banner.png';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /* The landing page is one screen: its content is centred in whatever
     is left of the window between the bar and the footer. */
  cover?: boolean;
}

const {
  title = 'Pytho',
  description =
    'Pytho — security researcher and bug bounty hunter. Hack The Box writeups, profiles and contact.',
  image,
  cover = false,
} = Astro.props;

// Absolute URLs for social-share (Open Graph / Twitter) link previews.
const site = Astro.site ?? new URL('https://pytho0.day');
const ogImage = new URL(image ? url(image) : banner.src, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, iMessage, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pytho" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Pytho — security researcher" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%230B0B0F'/><text x='50' y='72' font-size='68' font-family='monospace' font-weight='700' fill='%232BE39B' text-anchor='middle'>P</text></svg>" />

    <!-- The two faces are served from this site; see src/styles/fonts.css.
         Preloaded here because the interface is monospaced from the first
         pixel, and swapping it in late shifts every line. -->
    <link rel="preload" href={url('/fonts/jetbrains-mono-400-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/jetbrains-mono-700-latin.woff2')} as="font" type="font/woff2" crossorigin />

    <!-- Moving between pages swaps the content in place instead of
         reloading, so the bar stays put and a writeup's title can grow
         out of its row in the list. Page scripts therefore run on
         astro:page-load, not once on load. -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <Bar />

    <div class="wrap">
      <main id="main" tabindex="-1" class={cover ? 'is-cover' : undefined}>
        <slot />
      </main>

      <footer class="foot">
        <span>pytho13@proton.me</span>
        <a href="https://github.com/Pytho2535" rel="noopener">github.com/Pytho2535</a>
      </footer>
    </div>
  </body>
</html>
