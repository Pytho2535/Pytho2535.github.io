---
import '../styles/global.css';
import '../styles/portfolio.css';
import '../styles/writeup.css';
import { ClientRouter } from 'astro:transitions';
import Bar from '../components/Bar.astro';
import { url } from '../lib/url';
/* Imported rather than served from public/, so its URL carries a hash of
   the file. Discord, Slack and the rest cache a link preview by image
   URL; a new banner under the old name would never be fetched again. */
import banner from '../assets/banner.png';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /* The landing page is one screen: its content is centred in whatever
     is left of the window between the bar and the footer. */
  cover?: boolean;
}

const {
  title = 'Pytho',
  description =
    'Pytho — security researcher and bug bounty hunter. Hack The Box writeups, profiles and contact.',
  image,
  cover = false,
} = Astro.props;

// Absolute URLs for social-share (Open Graph / Twitter) link previews.
const site = Astro.site ?? new URL('https://pytho0.day');
const ogImage = new URL(image ? url(image) : banner.src, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, iMessage, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pytho" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Pytho — security researcher" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50' fill='%2305070d'/><circle cx='50' cy='50' r='26' fill='none' stroke='%232BE39B' stroke-width='6'/><circle cx='70' cy='30' r='7' fill='%232BE39B'/></svg>" />

    <!-- The faces are served from this site; see src/styles/fonts.css.
         The serif sets the large headings and the sans everything else,
         so those two are fetched before the page asks for them. -->
    <link rel="preload" href={url('/fonts/instrument-serif-400-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/instrument-sans-400-latin.woff2')} as="font" type="font/woff2" crossorigin />

    <!-- Marks the page as scripted, and animated, before it is drawn, so
         what is about to rise into place does not flash in its final spot
         first, and what a button folds away starts folded. The
         router replaces the attributes of <html> on every swap, hence the
         listener. -->
    <script is:inline>
      (function () {
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var mark = function () {
          document.documentElement.classList.add('js');
          if (!still) document.documentElement.classList.add('js-motion');
        };
        mark();
        document.addEventListener('astro:after-swap', mark);
      })();
    </script>

    <!-- Moving between pages swaps the content in place instead of
         reloading, so the stars carry on and a writeup's title can move
         over from its row in the list. Page scripts therefore run on
         astro:page-load, not once on load.

         The browser's own view transition is switched off first, so the
         router swaps the page directly ("swap"). That transition shows a
         still picture of the screen while it runs, which froze the stars
         and cut the fly-in short; the pages animate themselves instead
         (scripts/motion.ts). -->
    <script is:inline>
      try { delete Document.prototype.startViewTransition; } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <!-- Kept across page swaps, so the stars and the cursor carry on
         instead of starting again on every page. -->
    <canvas class="space" aria-hidden="true" data-space transition:persist="space"></canvas>
    <div class="cursor-ring" aria-hidden="true" data-cursor-ring transition:persist="cursor-ring"><span class="cursor-label"></span></div>
    <div class="cursor-dot" aria-hidden="true" data-cursor-dot transition:persist="cursor-dot"></div>
    <div class="progress" aria-hidden="true" data-progress></div>

    <Bar />

    <div class="wrap">
      <main id="main" tabindex="-1" class={cover ? 'is-cover' : undefined}>
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/motion';
      import '../scripts/cursor';
      import '../scripts/space';
    </script>
  </body>
</html>
