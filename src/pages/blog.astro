---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { getCollection } from 'astro:content';

// Writeups from the content collection, drafts hidden, newest first.
const posts = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title="Writeups"
  description="Hack The Box writeups and notes, newest first."
>
  <section class="section" aria-labelledby="writeups-head">
    <h2 class="head" id="writeups-head">writeups</h2>
    <div class="rule"></div>

    <div class="rows">
      {posts.length === 0 && (
        <p class="empty">
          Nothing published yet. One entry per machine, written after it was
          finished rather than while it was running.
        </p>
      )}

      {posts.map((post) => (
        <a class="row" href={url(`/blog/${post.id}`)}>
          <time class="row-date" datetime={iso(post.data.date)}>{iso(post.data.date)}</time>
          <span class="row-body">
            <span class="row-name" transition:name={`post-${post.id}`}>{post.data.title}</span>
            <span class="row-note">{post.data.excerpt}</span>
          </span>
          <span class="row-tag">{post.data.tag}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
