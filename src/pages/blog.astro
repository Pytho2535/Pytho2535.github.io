---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { getCollection } from 'astro:content';

// Pull writeups from the content collection, hide drafts, newest first.
const posts = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const delays = ['0.12s', '0.2s', '0.28s', '0.36s', '0.44s'];
---

<Base title="Blog & Writeups — Pytho">
  <section class="page">
    <div style="animation: rise 0.7s 0.05s both cubic-bezier(0.2,0.7,0.2,1);">
      <span class="eyebrow">03 / blog</span>
      <h2 class="section-title">Blog &amp; writeups</h2>
      <p class="section-lede">Writeups and notes.</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 44px;">
      {posts.length === 0 && (
        <p style="font-family: 'JetBrains Mono', monospace; font-size: 14px; color: rgba(236,236,238,0.5);">
          No writeups published yet — check back soon.
        </p>
      )}

      {posts.map((post, i) => (
        <a
          class="blog-row"
          href={url(`/blog/${post.id}`)}
          style={`animation: rise 0.7s both cubic-bezier(0.2,0.7,0.2,1); animation-delay: ${delays[i % delays.length]}; display: flex; align-items: center; gap: 24px; padding: 22px 26px; border-radius: 18px; background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);`}
        >
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: rgba(236,236,238,0.4); min-width: 92px;">{fmt(post.data.date)}</span>
          <div style="flex: 1;">
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 500; color: rgba(236,236,238,0.85);">{post.data.title}</div>
            <div style="margin-top: 5px; font-size: 14px; color: rgba(236,236,238,0.5);">{post.data.excerpt}</div>
          </div>
          <span class="blog-tag" style="padding: 5px 11px; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #ffb199; background: rgba(255,122,89,0.1); border: 1px solid rgba(255,122,89,0.22); white-space: nowrap;">{post.data.tag}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
