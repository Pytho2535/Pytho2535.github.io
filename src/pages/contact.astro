---
import Base from '../layouts/Base.astro';
import { email, handles } from '../lib/site';
import { pgpKey, pgpFacts } from '../lib/pgp';
import { url } from '../lib/url';

const keyUrl = url('/pgp.asc');
const importCmd = `curl -s ${new URL(keyUrl, Astro.site)} | gpg --import`;
---

<Base title="Contact" description="Mail, PGP public key and platform handles.">
  <section class="section" aria-labelledby="contact-head">
    <h2 class="head" id="contact-head">contact</h2>
    <div class="rule"></div>

    <dl class="record">
      <div class="rec">
        <dt>mail</dt>
        <dd>
          <a href={`mailto:${email}`}>{email}</a>
          <button class="copy-btn" type="button" data-copy={email}>copy</button>
        </dd>
      </div>
      {handles.map((h) => (
        <div class="rec">
          <dt>{h.kind}</dt>
          <dd><a href={h.href} target="_blank" rel="noopener">{h.handle}</a></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="pgp-head">
    <h2 class="head" id="pgp-head">pgp public key</h2>
    <div class="rule"></div>

    <div class="pgp">
      <div class="pgp-side">
        <div class="note">
          <p>
            Encrypt anything that should not sit in a mailbox in plain text. Import
            the key and check the fingerprint matches before you trust it.
          </p>
        </div>

        <dl class="record pgp-record">
          <div class="rec">
            <dt>fingerprint</dt>
            <dd class="pgp-fpr">{pgpFacts.fingerprint}</dd>
          </div>
          <div class="rec">
            <dt>key</dt>
            <dd>{pgpFacts.algorithm}</dd>
          </div>
          <div class="rec">
            <dt>valid</dt>
            <dd>{pgpFacts.created} → {pgpFacts.expires}</dd>
          </div>
        </dl>

        <pre class="keyblock pgp-cmd"><span class="pgp-sigil">$ </span>{importCmd}</pre>

        <div class="pgp-actions">
          <button class="copy-btn" type="button" data-copy={importCmd}>copy command</button>
          <button class="copy-btn" type="button" data-copy={pgpKey}>copy key</button>
          <a class="copy-btn" href={keyUrl} download="pytho.asc">download .asc</a>
        </div>
      </div>

      <pre class="keyblock pgp-key" aria-label="PGP public key block">{pgpKey}</pre>
    </div>
  </section>
</Base>

<script>
  // A state change the reader caused, reported in text rather than in motion.
  // Bound on every arrival, since pages are swapped in place (Base.astro).
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
      const label = btn.textContent;
      let reset: number | undefined;
      btn.addEventListener('click', async () => {
        const value = btn.getAttribute('data-copy') ?? '';
        try {
          await navigator.clipboard.writeText(value);
          btn.textContent = 'copied';
        } catch {
          // No clipboard access (insecure origin, or the user declined). The
          // text is selectable right next to the button, so say so.
          btn.textContent = 'select it';
        }
        window.clearTimeout(reset);
        reset = window.setTimeout(() => (btn.textContent = label), 1600);
      });
    });
  });
</script>

<style>
  /* The key is narrow and long, so on a wide screen it takes the right
     column and what you need to use it sits beside it, instead of the
     block hugging the left edge with nothing next to it. */
  .pgp {
    display: grid;
    gap: var(--space-step);
    margin-top: var(--space-step);
  }
  .pgp-side { min-width: 0; display: flex; flex-direction: column; gap: var(--space-step); }
  .pgp-record .rec { grid-template-columns: 8rem minmax(0, 1fr); }
  .pgp-fpr { color: var(--accent); letter-spacing: 0.02em; }
  .pgp .keyblock { margin: 0; }
  .pgp-cmd { color: var(--ink-muted); }
  .pgp-sigil { color: var(--accent); }
  .pgp-actions { display: flex; flex-wrap: wrap; gap: var(--space-tight) var(--space-step); }
  .pgp-actions .copy-btn { margin-left: 0; text-decoration: none; }

  @media (max-width: 46rem) {
    .pgp-record .rec { grid-template-columns: minmax(0, 1fr); }
  }

  @media (min-width: 64rem) {
    .pgp { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    /* The key is twice as tall as what sits beside it, so the side
       stays in view while the key scrolls past. */
    .pgp-side { position: sticky; top: 5.5rem; }
    /* Printed at its own width, the way gpg prints it: 64 columns. */
    .pgp-key { white-space: pre; word-break: normal; }
  }
</style>
