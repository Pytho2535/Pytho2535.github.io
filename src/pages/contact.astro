<Base title="Contact — Pytho" description="Mail, PGP public key and platform handles.">
  <section class="section" aria-labelledby="contact-head">
    <h2 class="head" id="contact-head">contact</h2>
    <div class="rule"></div>

    <dl class="record">
      <div class="rec">
        <dt>mail</dt>
        <dd>
          <a href={`mailto:${email}`}>{email}</a>
          <button class="copy-btn" type="button" id="copy-email" data-copy={email}>copy</button>
        </dd>
      </div>
      {handles.map((h) => (
        <div class="rec">
          <dt>{h.kind}</dt>
          <dd><a href={h.href} target="_blank" rel="noopener">{h.handle}</a></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="pgp-head">
    <h2 class="head" id="pgp-head">pgp public key</h2>
    <div class="rule"></div>

    <div class="note">
      <p>
        Encrypt anything that should not sit in a mailbox in plain text. Import
        the key below and check the user ID matches before you trust it.
      </p>
    </div>

    <pre class="keyblock" aria-label="PGP public key block">{pgp}</pre>
  </section>
</Base>

<script>
  // A state change the reader caused, reported in text rather than in motion.
  const btn = document.getElementById('copy-email');
  btn?.addEventListener('click', async () => {
    const value = btn.getAttribute('data-copy') ?? '';
    try {
      await navigator.clipboard.writeText(value);
      btn.textContent = 'copied';
      setTimeout(() => (btn.textContent = 'copy'), 1600);
    } catch {
      // No clipboard access (insecure origin, or the user declined). The
      // address is selectable text right next to the button, so say so.
      btn.textContent = 'select it';
    }
  });
</script>
