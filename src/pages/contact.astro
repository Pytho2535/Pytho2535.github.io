<Base title="Contact — Pytho">
  <section class="page">
    <div style="animation: rise 0.7s 0.05s both cubic-bezier(0.2,0.7,0.2,1);">
      <span class="eyebrow">04 / contact</span>
      <h2 class="section-title">Get in touch</h2>
      <p class="section-lede">Reach out to me :)</p>
    </div>

    <div
      class="contact-grid"
      style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 16px; margin-top: 44px;"
    >
      <div
        class="contact-hero"
        style="animation: rise 0.7s 0.14s both cubic-bezier(0.2,0.7,0.2,1); grid-row: span 2; display: flex; flex-direction: column; justify-content: space-between; padding: 26px; border-radius: 20px; background: linear-gradient(160deg, rgba(255,122,89,0.14), rgba(255,255,255,0.03)); border: 1px solid rgba(255,122,89,0.24); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); min-height: 180px;"
      >
        <div>
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #ffb199;">email</span>
          <div style="margin-top: 12px; font-family: 'Space Grotesk', sans-serif; font-size: clamp(20px, 3vw, 26px); font-weight: 600; color: #f6f6f8; word-break: break-all;">{email}</div>
        </div>
        <div style="display: flex; gap: 10px; margin-top: 22px;">
          <a
            href={`mailto:${email}`}
            style="display: inline-flex; align-items: center; padding: 11px 18px; border-radius: 12px; font-weight: 600; font-size: 14px; color: #16110f; background: linear-gradient(180deg, #ff9070, #ff7a59); box-shadow: inset 0 1px 0 rgba(255,255,255,0.35);"
          >
            Send email
          </a>
          <button
            id="copy-email"
            data-email={email}
            style="display: inline-flex; align-items: center; padding: 11px 18px; border-radius: 12px; font-weight: 600; font-size: 14px; font-family: 'JetBrains Mono', monospace; cursor: pointer; color: #ececee; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);"
          >
            copy
          </button>
        </div>
      </div>

      {socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          style={`animation: rise 0.7s both cubic-bezier(0.2,0.7,0.2,1); animation-delay: ${s.delay}; display: flex; flex-direction: column; justify-content: space-between; min-height: 120px; padding: 22px; border-radius: 18px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);`}
        >
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(236,236,238,0.45);">{s.kind}</span>
            <span style="font-family: 'JetBrains Mono', monospace; color: #ff8f70;">↗</span>
          </div>
          <div style="font-family: 'Space Grotesk', sans-serif; font-size: 19px; font-weight: 600; color: #f4f4f6;">{s.handle}</div>
        </a>
      ))}
    </div>

    <div style="animation: rise 0.7s 0.34s both cubic-bezier(0.2,0.7,0.2,1); margin-top: 20px; padding: 24px 26px; border-radius: 20px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.09); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #ff8f70;">PGP key</span>
      </div>
      <pre style="margin: 16px 0 0; padding: 18px; border-radius: 12px; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.07); font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.7; color: rgba(236,236,238,0.42); overflow-x: auto; white-space: pre-wrap; text-align: center;">{pgp}</pre>
    </div>
  </section>
</Base>

<script>
  const btn = document.getElementById('copy-email');
  if (btn) {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || '';
      try {
        await navigator.clipboard.writeText(email);
        const prev = btn.textContent;
        btn.textContent = 'copied ✓';
        setTimeout(() => (btn.textContent = prev), 1600);
      } catch {
        /* clipboard unavailable — ignore */
      }
    });
  }
</script>
