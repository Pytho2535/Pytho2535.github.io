---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const socials = [
  { label: 'HackTheBox ↗', href: 'https://app.hackthebox.com/users/1710921' },
  { label: 'GitHub ↗', href: 'https://github.com/Pytho2535' },
  { label: 'X ↗', href: 'https://x.com/Pytho_01' },
];
---

<Base>
  <section
    class="page"
    style="min-height: 66vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center;"
  >
    <h1
      style="animation: rise 0.7s 0.12s both cubic-bezier(0.2,0.7,0.2,1); margin: 0; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(64px, 13vw, 168px); line-height: 0.92; letter-spacing: -0.03em; color: #f6f6f8; text-shadow: 0 0 60px rgba(255,122,89,0.18);"
    >
      Pytho
    </h1>
    <p
      style="animation: rise 0.7s 0.2s both cubic-bezier(0.2,0.7,0.2,1); margin: 22px 0 0; max-width: 560px; font-size: clamp(17px, 2.4vw, 21px); line-height: 1.5; color: rgba(236,236,238,0.72);"
    >
      Security researcher &amp; bug bounty hunter.
    </p>

    <div
      style="animation: rise 0.7s 0.28s both cubic-bezier(0.2,0.7,0.2,1); display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px;"
    >
      <a
        href={url('/wall')}
        style="display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 14px; font-weight: 600; font-size: 15px; color: #16110f; background: linear-gradient(180deg, #ff9070, #ff7a59); box-shadow: 0 10px 30px rgba(255,122,89,0.32), inset 0 1px 0 rgba(255,255,255,0.35);"
      >
        Wall of Fame <span style="font-family: 'JetBrains Mono', monospace;">→</span>
      </a>
      <a
        href={url('/contact')}
        style="display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 14px; font-weight: 600; font-size: 15px; color: #ececee; background: rgba(255,255,255,0.045); border: 1px solid rgba(255,255,255,0.11); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);"
      >
        Get in touch
      </a>
    </div>

    <div
      style="animation: rise 0.7s 0.36s both cubic-bezier(0.2,0.7,0.2,1); display: flex; flex-wrap: wrap; gap: 26px; margin-top: 56px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: rgba(236,236,238,0.5);"
    >
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" style="color: rgba(236,236,238,0.5);">{s.label}</a>
      ))}
    </div>
  </section>
</Base>
