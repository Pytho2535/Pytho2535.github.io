---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Botnet from '../components/Botnet.astro';
import { url } from '../lib/url';

/* The landing page is the wordmark and the three ways into the site.
   Nothing else: the writeups have their own index one click away. */

const sections = [
  {
    name: '~/writeups',
    href: '/blog',
    note: 'Hack The Box machine writeups',
  },
  {
    name: '~/wall-of-fame',
    href: '/wall',
    note: 'Certificates and achievements',
  },
  {
    name: '~/contact',
    href: '/contact',
    note: 'Everything you need to reach out to me',
  },
];
---

<Base cover>
  <section class="hero hero-centred hero-botnet">
    <button type="button" class="ddos-switch" data-ddos-switch aria-pressed="false">
      <span class="ddos-switch-label">ddos</span><span class="ddos-switch-sep">:</span><span class="ddos-switch-state" data-ddos-state>off</span>
    </button>
    <Logo />
    <Botnet />
  </section>

  <div class="rule"></div>

  <section class="section" aria-label="Sections">
    <div class="cards">
      {sections.map((s, i) => (
        <a class="card" href={url(s.href)} style={`--i: ${i}`}>
          <span class="card-arrow" aria-hidden="true">&#8594;</span>
          <h3 class="card-name">{s.name}</h3>
          <p class="card-note">{s.note}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
