---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const profiles = [
  { name: 'HackTheBox', handle: '@Pytho', href: 'https://app.hackthebox.com/users/1710921' },
  { name: 'Intigriti', handle: '@pytho1', href: 'https://app.intigriti.com/profile/pytho1' },
  { name: 'HackerOne', handle: '@pytho1', href: 'https://hackerone.com/pytho1?type=user' },
];

/* Held certificates carry their scan; the ones being worked towards
   are an empty slot that says so, so the two can never be read as the
   same thing. */
const certs = [
  { label: 'CompTIA Security+', src: '/images/cert-secplus.webp', status: 'held' },
  { label: 'HTB CPTS', src: null, status: 'in progress' },
];
---

<Base title="Wall of Fame — Pytho" description="Platform profiles and certificates.">
  <section class="section" aria-labelledby="profiles-head">
    <h2 class="head" id="profiles-head">profiles</h2>
    <div class="rule"></div>

    <div class="rows">
      {profiles.map((p) => (
        <a class="row" href={p.href} target="_blank" rel="noopener">
          <span class="row-date">{p.handle}</span>
          <span class="row-body">
            <span class="row-name">{p.name}</span>
          </span>
          <span class="row-tag">open &#8599;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="certs-head">
    <h2 class="head" id="certs-head">certificates</h2>
    <div class="rule"></div>

    <div class="cards">
      {certs.map((c) => (
        c.src ? (
          <figure class="shot shot-narrow">
            <img src={url(c.src)} alt={c.label} width="1200" height="927" loading="lazy" />
            <figcaption>{c.label} · {c.status}</figcaption>
          </figure>
        ) : (
          <figure class="shot shot-narrow">
            <div class="cert-slot">
              <span class="cert-slot-name">{c.label}</span>
              <span class="cert-slot-status">{c.status}</span>
            </div>
          </figure>
        )
      ))}
    </div>
  </section>
</Base>
