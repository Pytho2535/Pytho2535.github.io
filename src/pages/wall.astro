---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const profiles = [
  { kind: 'platform', name: 'HackTheBox', handle: '@Pytho', stat: 'view profile', href: 'https://app.hackthebox.com/users/1710921', delay: '0.12s' },
  { kind: 'platform', name: 'Intigriti', handle: '@pytho1', stat: 'view profile', href: 'https://app.intigriti.com/profile/pytho1', delay: '0.2s' },
  { kind: 'platform', name: 'HackerOne', handle: '@pytho1', stat: 'view profile', href: 'https://hackerone.com/pytho1?type=user', delay: '0.28s' },
];

// The first cert is real; the rest are "coming soon" placeholders.
const certs = [
  { label: 'CompTIA Security+', src: url('/images/cert-secplus.webp') },
  { label: '', src: '' },
  { label: '', src: '' },
  { label: '', src: '' },
];
---

<Base title="Wall of Fame — Pytho">
  <section class="page">
    <div style="animation: rise 0.7s 0.05s both cubic-bezier(0.2,0.7,0.2,1);">
      <span class="eyebrow">02 / wall of fame</span>
      <h2 class="section-title">Wall of Fame</h2>
      <p class="section-lede">Profiles, platforms and proof of work.</p>
    </div>

    <div
      class="wall-grid"
      style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 44px;"
    >
      {profiles.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          style={`animation: rise 0.7s both cubic-bezier(0.2,0.7,0.2,1); animation-delay: ${p.delay}; position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 200px; padding: 24px; border-radius: 20px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%); box-shadow: 0 12px 40px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.07); overflow: hidden;`}
        >
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(236,236,238,0.45);">{p.kind}</span>
            <span style="font-family: 'JetBrains Mono', monospace; color: #ff8f70;">↗</span>
          </div>
          <div>
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 24px; font-weight: 600; color: #f4f4f6;">{p.name}</div>
            <div style="margin-top: 6px; font-size: 14px; color: rgba(236,236,238,0.6);">{p.handle}</div>
          </div>
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: #ffb199;">{p.stat}</div>
        </a>
      ))}
    </div>

    <div style="animation: rise 0.7s 0.3s both cubic-bezier(0.2,0.7,0.2,1); margin-top: 52px;">
      <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(236,236,238,0.45);">certificates</span>
      <div
        class="cert-grid"
        style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 18px;"
      >
        {certs.map((c) => (
          <div style="position: relative; aspect-ratio: 1/1; border-radius: 16px; overflow: hidden; border: 1px dashed rgba(255,255,255,0.14);">
            {c.src ? (
              <img src={c.src} alt={c.label} style="width: 100%; height: 100%; object-fit: contain; display: block;" />
            ) : (
              <span style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 10px; background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.05) 0 12px, rgba(255,255,255,0.012) 12px 24px); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(236,236,238,0.4);">
                coming soon
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
