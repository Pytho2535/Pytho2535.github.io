---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('writeups');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={`${post.data.title} — Pytho`} description={post.data.excerpt}>
  <article class="page" style="max-width: 760px; margin: 0 auto;">
    <a href={url('/blog')} class="eyebrow" style="display: inline-block;">← back to blog</a>

    <header style="margin-top: 20px; animation: rise 0.7s 0.05s both cubic-bezier(0.2,0.7,0.2,1);">
      <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: rgba(236,236,238,0.4);">{fmt(post.data.date)}</span>
        <span style="padding: 5px 11px; border-radius: 999px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #ffb199; background: rgba(255,122,89,0.1); border: 1px solid rgba(255,122,89,0.22);">{post.data.tag}</span>
      </div>
      <h1 style="margin: 16px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(32px, 5.5vw, 52px); line-height: 1.05; letter-spacing: -0.02em; color: #f4f4f6;">
        {post.data.title}
      </h1>
      <p style="margin: 14px 0 0; font-size: 17px; line-height: 1.5; color: rgba(236,236,238,0.6);">{post.data.excerpt}</p>
    </header>

    <div class="prose" style="margin-top: 40px; animation: rise 0.7s 0.15s both cubic-bezier(0.2,0.7,0.2,1);">
      <Content />
    </div>
  </article>

  {/*
    Click any image in a post to open it here. Wide terminal screenshots shrink a
    lot to fit a phone screen, so a second click switches to 1:1 and scrolls.
  */}
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview" hidden>
    <div class="lightbox-scroll" id="lightbox-scroll">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    </div>
    <button class="lightbox-close" type="button" aria-label="Close image preview">&times;</button>
  </div>
</Base>

<script>
  const box = document.getElementById('lightbox')!;
  const boxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const scroller = document.getElementById('lightbox-scroll')!;
  const closeBtn = box.querySelector('.lightbox-close') as HTMLButtonElement;
  let lastFocused: HTMLElement | null = null;

  // `main` sets `z-index: 10`, which traps anything inside it below the nav's
  // stacking order. Reparent to <body> so the overlay covers the whole page.
  document.body.appendChild(box);

  // Only offer the 1:1 view when the fitted image is actually smaller than the
  // original, otherwise zooming in would just blur it.
  function refreshZoomAffordance() {
    const shrunk =
      boxImg.naturalWidth > boxImg.clientWidth || boxImg.naturalHeight > boxImg.clientHeight;
    box.classList.toggle('can-zoom', shrunk);
  }

  function open(img: HTMLImageElement) {
    boxImg.src = img.currentSrc || img.src;
    boxImg.alt = img.alt;
    lastFocused = document.activeElement as HTMLElement;
    box.classList.remove('is-zoomed', 'can-zoom');
    box.hidden = false;
    scroller.scrollTop = 0;
    scroller.scrollLeft = 0;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
    if (boxImg.complete) refreshZoomAffordance();
  }

  function close() {
    box.hidden = true;
    boxImg.removeAttribute('src');
    box.classList.remove('is-zoomed', 'can-zoom');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  boxImg.addEventListener('load', refreshZoomAffordance);

  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    img.addEventListener('click', () => open(img));
  });

  // On the image: toggle 1:1 if there is detail to gain, otherwise just close.
  boxImg.addEventListener('click', (e) => {
    e.stopPropagation();
    if (box.classList.contains('is-zoomed')) {
      box.classList.remove('is-zoomed');
      refreshZoomAffordance();
    } else if (box.classList.contains('can-zoom')) {
      box.classList.add('is-zoomed');
      // Centre the 1:1 view rather than dumping the user at the top-left corner.
      scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2;
      scroller.scrollTop = (scroller.scrollHeight - scroller.clientHeight) / 2;
    } else {
      close();
    }
  });

  // Backdrop and close button always dismiss.
  box.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !box.hidden) close();
  });
</script>

<style is:global>
  .prose { font-size: 16.5px; line-height: 1.75; color: rgba(236,236,238,0.82); }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 26px; letter-spacing: -0.01em; color: #f4f4f6; margin-top: 1.8em; }
  .prose h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 20px; color: #f4f4f6; margin-top: 1.5em; }
  .prose a { color: #ff8f70; text-decoration: underline; text-underline-offset: 3px; }
  .prose a:hover { color: #ffb199; }
  .prose strong { color: #f4f4f6; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose li + li { margin-top: 0.4em; }
  .prose blockquote {
    margin: 0; padding: 4px 20px; border-left: 3px solid rgba(255,122,89,0.5);
    color: rgba(236,236,238,0.65); font-style: italic;
  }
  .prose code {
    font-family: 'JetBrains Mono', monospace; font-size: 0.86em;
    background: rgba(255,255,255,0.07); padding: 2px 6px; border-radius: 6px;
  }
  .prose pre {
    background: rgba(0,0,0,0.4) !important; border: 1px solid rgba(255,255,255,0.08);
    padding: 18px; border-radius: 12px; overflow-x: auto; font-size: 13.5px; line-height: 1.6;
  }
  .prose pre code { background: transparent; padding: 0; font-size: inherit; }
  .prose img { max-width: 100%; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); cursor: zoom-in; }

  /* Full-size image viewer, opened by clicking a post image. */
  .lightbox {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: center; justify-content: center;
    padding: 32px;
    background: rgba(10, 7, 12, 0.9);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    animation: lightbox-in 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .lightbox[hidden] { display: none; }
  /* Fills the overlay's content box so the image's `max-height: 100%` has a
     definite height to resolve against. */
  .lightbox-scroll {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
  }
  .lightbox-img {
    max-width: 100%; max-height: 100%; object-fit: contain;
    border-radius: 12px; border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 24px 70px rgba(0,0,0,0.6);
    cursor: zoom-out;
  }
  /* Fitted view that still has detail to reveal: clicking goes to 1:1. */
  .lightbox.can-zoom .lightbox-img { cursor: zoom-in; }
  /* 1:1 view: the inner wrapper scrolls, so the overlay and its close button
     stay pinned to the viewport while panning. */
  .lightbox.is-zoomed { padding: 0; }
  .lightbox.is-zoomed .lightbox-scroll { display: block; overflow: auto; }
  .lightbox.is-zoomed .lightbox-img {
    max-width: none; max-height: none;
    border-radius: 0; border: none; box-shadow: none;
    cursor: zoom-out;
  }
  .lightbox-close {
    position: absolute; z-index: 1; top: 18px; right: 20px;
    width: 40px; height: 40px; padding: 0;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Grotesk', sans-serif; font-size: 26px; line-height: 1;
    color: rgba(236,236,238,0.7); background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12); border-radius: 999px;
    cursor: pointer; transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .lightbox-close:hover { color: #ffb199; background: rgba(255,122,89,0.12); border-color: rgba(255,122,89,0.3); }
  @keyframes lightbox-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .lightbox { animation: none; } }
  @media (max-width: 640px) { .lightbox { padding: 16px; } .lightbox-close { top: 10px; right: 12px; } }
  .prose hr { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 2em 0; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .prose th, .prose td { border: 1px solid rgba(255,255,255,0.1); padding: 8px 12px; text-align: left; }
  /* Headerless key/value tables still emit an empty <thead> row in Markdown —
     collapse it instead of rendering a blank band above the first row. */
  .prose thead th:empty { padding: 0; border: none; }
</style>
