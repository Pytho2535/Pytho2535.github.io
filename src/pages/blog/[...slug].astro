---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('writeups');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, headings } = await render(post);

/* The contents list is built from the headings the writeup actually
   has. A post with one heading or none gets no list, because a list
   of one is a label and a list of none is an empty box. */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title={post.data.title} description={post.data.excerpt}>
  <article class="section">
    <header class="post-head">
      <div class="post-meta" data-arrive>
        <time datetime={iso(post.data.date)}>{iso(post.data.date)}</time>
        <span class="row-tag">{post.data.tag}</span>
      </div>
      <h1 class="post-title" data-carry>{post.data.title}<span>.</span></h1>
      <p class="post-lede" data-arrive>{post.data.excerpt}</p>
    </header>

    <div class="post-layout" data-arrive>
      {toc.length > 1 && (
        <details class="toc" open>
          <summary class="toc-open">contents</summary>
          <nav aria-label="Sections of this writeup">
            <ol class="toc-list">
              {toc.map((h) => (
                <li class={`toc-item toc-d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>

    <a class="row-more post-back" data-arrive href={url('/#writeups')} data-magnetic="0.2">&#8592; back to writeups</a>
  </article>

  {/*
    Click any image in a post to open it here. Wide terminal screenshots shrink a
    lot to fit a phone screen, so a second click switches to 1:1 and scrolls.
  */}
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview" hidden>
    <div class="lightbox-scroll" id="lightbox-scroll" data-lenis-prevent>
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    </div>
    <button class="lightbox-close" type="button" aria-label="Close image preview">&times;</button>
  </div>
</Base>

<script>
  import { getLenis, scrollToTarget } from '../../scripts/motion';

  // Pages are swapped in place (see Base.astro), so this runs on every
  // arrival at a writeup rather than once. Everything it hangs on the
  // document is dropped again before the next page replaces this one.
  document.addEventListener('astro:page-load', () => {
    const box = document.getElementById('lightbox');
    if (!box) return;

    const page = new AbortController();
    const signal = page.signal;
    document.addEventListener('astro:before-swap', () => page.abort(), { once: true });

    const boxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const scroller = document.getElementById('lightbox-scroll')!;
    const closeBtn = box.querySelector('.lightbox-close') as HTMLButtonElement;
    let lastFocused: HTMLElement | null = null;
    let closing: number | undefined;

    // The bar is sticky and the article sits inside the page column, so the
    // overlay is reparented to <body> to be sure it covers both.
    document.body.appendChild(box);

    // Only offer the 1:1 view when the fitted image is actually smaller than the
    // original, otherwise zooming in would just blur it.
    function refreshZoomAffordance() {
      const shrunk =
        boxImg.naturalWidth > boxImg.clientWidth || boxImg.naturalHeight > boxImg.clientHeight;
      box!.classList.toggle('can-zoom', shrunk);
    }

    function open(img: HTMLImageElement) {
      window.clearTimeout(closing);
      box!.classList.remove('is-closing', 'is-zoomed', 'can-zoom');
      boxImg.src = img.currentSrc || img.src;
      boxImg.alt = img.alt;
      lastFocused = document.activeElement as HTMLElement;
      box!.hidden = false;
      scroller.scrollTop = 0;
      scroller.scrollLeft = 0;
      document.body.style.overflow = 'hidden';
      getLenis()?.stop();
      closeBtn.focus();
      if (boxImg.complete) refreshZoomAffordance();
    }

    // The overlay fades out before it is hidden. The wait matches
    // --duration-enter; under reduced motion the fade is instant anyway.
    function close() {
      if (box!.hidden || box!.classList.contains('is-closing')) return;
      box!.classList.add('is-closing');
      document.body.style.overflow = '';
      getLenis()?.start();
      lastFocused?.focus();
      closing = window.setTimeout(() => {
        box!.hidden = true;
        box!.classList.remove('is-closing', 'is-zoomed', 'can-zoom');
        boxImg.removeAttribute('src');
      }, 200);
    }

    boxImg.addEventListener('load', refreshZoomAffordance);

    // Every screenshot is reachable by keyboard as well as by pointer.
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(img);
        }
      });
    });

    // A writeup is mostly commands, so every block of them gets a button
    // that puts it on the clipboard. The block is wrapped rather than
    // restyled, so the button can sit over its top right corner.
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode?.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'Copy this block to the clipboard');
      wrap.appendChild(btn);

      let reset: number | undefined;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = 'copied';
        } catch {
          // The clipboard API refuses when the window is not focused, and
          // in a few other cases. Select the block instead, so the copy is
          // one keystroke away rather than a drag across forty lines.
          const range = document.createRange();
          range.selectNodeContents(pre);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          btn.textContent = 'ctrl+c';
        }
        window.clearTimeout(reset);
        reset = window.setTimeout(() => (btn.textContent = 'copy'), 1600);
      });
    });

    // On the image: toggle 1:1 if there is detail to gain, otherwise just close.
    boxImg.addEventListener('click', (e) => {
      e.stopPropagation();
      if (box.classList.contains('is-zoomed')) {
        box.classList.remove('is-zoomed');
        refreshZoomAffordance();
      } else if (box.classList.contains('can-zoom')) {
        box.classList.add('is-zoomed');
        // Centre the 1:1 view rather than dumping the user at the top-left corner.
        scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2;
        scroller.scrollTop = (scroller.scrollHeight - scroller.clientHeight) / 2;
      } else {
        close();
      }
    });

    // The contents list is collapsible on a narrow screen, where it would
    // otherwise push the writeup off the first screen. On a wide one the
    // summary is hidden, so it is forced back open to avoid a list that
    // cannot be reopened.
    const toc = document.querySelector('details.toc') as HTMLDetailsElement | null;
    if (toc) {
      const wide = window.matchMedia('(min-width: 64rem)');
      const sync = () => { if (wide.matches) toc.open = true; };
      wide.addEventListener('change', sync, { signal });
      sync();
    }

    // Mark the section being read. A heading counts as current once it
    // has passed the sticky bar, so the mark moves with the text rather
    // than with whatever happens to be in the middle of the viewport.
    const marks = document.querySelectorAll<HTMLAnchorElement>('.toc-item a');
    if (marks.length) {
      const targets = [...marks]
        .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
        .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => t.el !== null);

      let queued = false;
      const mark = () => {
        queued = false;
        let current = targets[0];
        for (const t of targets) {
          if (t.el.getBoundingClientRect().top <= 96) current = t;
        }
        for (const t of targets) {
          t.a.parentElement?.classList.toggle('is-here', t === current);
        }
      };
      document.addEventListener('scroll', () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(mark);
      }, { passive: true, signal });
      mark();

      // Following a contents link glides to the section rather than
      // jumping to it, unless the reader has asked for less motion.
      for (const t of targets) {
        t.a.addEventListener('click', (e) => {
          e.preventDefault();
          scrollToTarget(t.el);
          history.pushState(null, '', t.a.hash);
        }, { signal });
      }
    }

    // Backdrop and close button always dismiss.
    box.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.hidden) close();
    }, { signal });

    // Leaving with the viewer open would carry the scroll lock over.
    signal.addEventListener('abort', () => { document.body.style.overflow = ''; getLenis()?.start(); });
  });
</script>

<style is:global>
  /* ---- contents ------------------------------------------------
     On a wide screen it is a rail beside the writeup that follows the
     reader down; on a narrow one it collapses to a single line above
     the text. */

  .post-layout { display: grid; gap: var(--space-step); }
  /* A grid item is as wide as its widest child unless it is told
     otherwise, so one unbreakable table used to drag the whole column
     past the edge of a phone screen. */
  .post-layout > * { min-width: 0; }

  .toc {
    margin-top: var(--space-step);
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--space-tight) 1rem;
  }
  .toc-open {
    cursor: pointer;
    font-family: var(--face-mono);
    font-size: var(--size-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    list-style: none;
  }
  .toc-open::-webkit-details-marker { display: none; }
  .toc-open::after { content: " +"; color: var(--accent-deep); }
  .toc[open] .toc-open::after { content: " -"; }

  .toc-list {
    margin: var(--space-tight) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .toc-item { font-size: var(--size-sm); line-height: 1.5; }
  .toc-item + .toc-item { margin-top: 0.35rem; }
  .toc-item a { color: var(--ink-muted); }
  .toc-item a:hover { color: var(--accent); }
  .toc-d3 { padding-left: 1.2ch; font-size: var(--size-xs); }
  .toc-d3 a::before { content: "– "; color: var(--rule-strong); }
  /* The section being read, marked as the page scrolls. */
  .toc-item.is-here > a { color: var(--accent); }

  @media (min-width: 64rem) {
    .post-layout { grid-template-columns: minmax(0, 1fr) 14rem; }
    .prose { grid-column: 1; grid-row: 1; }
    .toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 6.5rem;
      align-self: start;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      background: none;
      border: none;
      border-left: 1px solid var(--rule);
      border-radius: 0;
      padding: 0 0 0 var(--space-tight);
    }
    .toc-open { display: none; }
  }

  /* ---- full-size screenshot viewer ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--overlay);
    animation: lightbox-in var(--duration-enter) var(--easing) both;
  }
  .lightbox[hidden] { display: none; }
  /* It fades in over the page and the screenshot settles from just
     under full size; closing plays the same thing backwards. */
  .lightbox .lightbox-img { animation: lightbox-img-in var(--duration-enter) var(--easing) both; }
  .lightbox.is-closing { animation-name: lightbox-out; }
  .lightbox.is-closing .lightbox-img { animation-name: lightbox-img-out; }
  @keyframes lightbox-in { from { opacity: 0; } }
  @keyframes lightbox-out { to { opacity: 0; } }
  @keyframes lightbox-img-in { from { transform: scale(0.97); } }
  @keyframes lightbox-img-out { to { transform: scale(0.97); } }
  .lightbox-scroll {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border: 1px solid var(--rule);
    cursor: zoom-out;
  }
  .lightbox.can-zoom .lightbox-img { cursor: zoom-in; }
  .lightbox.is-zoomed { padding: 0; }
  .lightbox.is-zoomed .lightbox-scroll { display: block; overflow: auto; }
  .lightbox.is-zoomed .lightbox-img { max-width: none; max-height: none; border: none; }
  .lightbox-close {
    position: absolute;
    z-index: 1;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--face-mono);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .lightbox-close:hover { color: var(--accent); border-color: var(--accent-deep); }

  @media (max-width: 46rem) {
    .lightbox { padding: 0.75rem; }
    .lightbox-close { top: 0.5rem; right: 0.5rem; }
  }
</style>
