---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

/* The error state. GitHub Pages serves this file for any address that
   is not a page, so it is the one screen a stranger can land on by
   accident. It says what happened and nothing else: the bar above it
   is already the way out. */
---

<Base
  title="404"
  description="That address is not on this site."
>
  <section class="section nf" aria-labelledby="nf-head">
    <h1 class="nf-code" id="nf-head" data-split>404<span>.</span></h1>
    <p class="nf-note reveal">
      Nothing is published at that address. Either it never was, or the file
      behind it was renamed
    </p>

    <a class="btn btn-ghost" href={url('/')} data-magnetic>&#8592; back to the front page</a>
  </section>
</Base>
