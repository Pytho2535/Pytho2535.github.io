---
import { url } from '../lib/url';

// Highlight the active nav item based on the current path.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

const items = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'about', label: 'About', href: '/about' },
  { id: 'wall', label: 'Wall of Fame', href: '/wall' },
  { id: 'blog', label: 'Blog', href: '/blog' },
  { id: 'contact', label: 'Contact', href: '/contact' },
];

function isActive(href: string): boolean {
  const target = (base + (href === '/' ? '' : href)) || '/';
  if (href === '/') return path === (base || '/') || path === base;
  return path === target || path.startsWith(target + '/');
}
---

<nav class="nav">
  <a href={url('/')} class="nav-logo">
    <span>Main Page</span>
  </a>
  <div class="nav-pills">
    {items.map((item) => (
      <a href={url(item.href)} class:list={['nav-pill', { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))}
  </div>
</nav>
