---
import { url } from '../lib/url';
const items = [
  { label: 'About', id: 'about' },
  { label: 'Certificates', id: 'certificates' },
  { label: 'Writeups', id: 'writeups' },
  { label: 'Profiles', id: 'profiles' },
  { label: 'Contact', id: 'contact' },
];
const home = Astro.url.pathname.replace(/\/+$/, '') === (import.meta.env.BASE_URL.replace(/\/+$/, '') || '');
const href = (id: string) => (home ? `#${id}` : url(`/#${id}`));
---

<header class="bar" data-bar>
  <a class="bar-mark" href={home ? '#top' : url('/')} aria-label="Pytho, home">pytho<span>.</span></a>
  <nav class="bar-nav" id="bar-nav" aria-label="Main navigation">
    <span class="bar-indicator" aria-hidden="true" data-bar-indicator></span>
    {items.map((item) => <a class="bar-link" href={href(item.id)} data-target={item.id}>{item.label}</a>)}
  </nav>
  <a class="bar-contact" href={href('contact')} data-magnetic>Let's talk <span aria-hidden="true">↗</span></a>
  <button class="bar-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="bar-nav" data-burger><span></span><span></span></button>
</header>

<script>
  import { getLenis } from '../scripts/motion';

  // The burger opens the sections as a full screen of links on a
  // phone. Choosing one, or Escape, closes it again.
  document.addEventListener('astro:page-load', () => {
    const bar = document.querySelector<HTMLElement>('[data-bar]');
    const burger = bar?.querySelector<HTMLButtonElement>('[data-burger]');
    if (!bar || !burger) return;
    const page = new AbortController();
    document.addEventListener('astro:before-swap', () => page.abort(), { once: true });
    const { signal } = page;

    const set = (open: boolean) => {
      bar.classList.toggle('menu-open', open);
      burger.setAttribute('aria-expanded', String(open));
      if (open) getLenis()?.stop(); else getLenis()?.start();
    };
    burger.addEventListener('click', () => set(!bar.classList.contains('menu-open')), { signal });
    bar.querySelectorAll('.bar-link').forEach((link) => link.addEventListener('click', () => set(false), { signal }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); }, { signal });
    signal.addEventListener('abort', () => set(false), { once: true });
  });
</script>
